<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Verification records document only some of their positional parameters. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RequestFlow.Benchmarks.ProjectDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>
</Project>
